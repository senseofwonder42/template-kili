ENVIRONMENT="local"
LOG_LEVEL="INFO"
RANDOM_SEED="42"

# --- Instance Kili on-premise ---------------------------------------------
# Copier ce fichier vers .env et renseigner les deux variables ci-dessous.
# Ne jamais committer le fichier .env : il contient un secret.

# Jeton d'API, généré depuis votre profil dans l'interface Kili.
KILI_API_KEY=""

# Endpoint GraphQL de l'instance auto-hébergée. L'URL se termine
# généralement par /api/label/v2/graphql
KILI_API_ENDPOINT="https://kili.mon-entreprise.local/api/label/v2/graphql"
